<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Callboard</RootNamespace>
    <AssemblyName>callboard</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- ADR-0002: single self-contained NativeAOT binary, no runtime at the point of use. -->
    <PublishAot>true</PublishAot>
    <RuntimeIdentifiers>osx-arm64</RuntimeIdentifiers>

    <!-- design.md D2 / ADR-0002: no unhandled analyzer or trim/AOT warning ships. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- D2/D4 (ADR-0002/ADR-0004): the derived index's only dependency. A native SQLite
         binding, not a reflection-based ORM, so it is the AOT-compatible choice. Verified by an
         out-of-repo scratch-project `dotnet publish -c Release -r osx-arm64` (nothing to check
         into this repo); the record of that verification is the DEVLOG
         (openspec/changes/establish-callboard/DEVLOG.md, §3), not any file under src/ — no gate
         re-runs the check (DEVLOG §3, supervisor note N1). Pinned to the .NET 10 band. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />

    <!-- Microsoft.Data.Sqlite 10.0.10 pins SQLitePCLRaw.bundle_e_sqlite3 2.1.11, which carries a
         known high-severity advisory (GHSA-2m69-gcr7-jv3q) that NuGet audit turns into a build
         error under TreatWarningsAsErrors. Pinned up to the first patched line explicitly; a
         direct top-level reference wins NuGet's version resolution over the transitive minimum. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />

    <!-- §3 obligation 2: enforces "only Program.cs touches Console" as a build error rather than
         a doc comment. Analyzer-only — loads into the compiler process, never the published
         binary, so it carries no AOT/trim implication (design.md D2 / ADR-0002). -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

</Project>

# .NET build output
bin/
obj/
*.user

# NativeAOT publish output
publish/

# callboard's derived index — rebuildable from the primary record, never authoritative,
# and never committed (ADR-0004). Committing it would make a disposable artefact look
# like a source of truth in review.
callboard/.index/
*.db
*.db-shm
*.db-wal

# callboard per-card advisory locks and atomic-write temp files (2.5/2.6) — process state, not
# record; never committed, same as the derived index above.
callboard/**/*.lock
callboard/**/*.tmp-*

# dmons tripwire scratch
.claude/.dmons-tripwire/

# local-only Claude Code settings (settings.json IS committed)
.claude/settings.local.json
.claude/.cc-writes/

# macOS
.DS_Store

# Microsoft.Testing.Platform run artefacts
TestResults/

# `make aot` scratch output — a section-close check, not an artefact to keep
artifacts/
